# Frontend (public). Leave both unset to run in local DEMO mode (no backend, data in the browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Edge function secrets (set with `supabase secrets set`, never commit):
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx
# ANTHROPIC_API_KEY=sk-ant-xxx        # optional: enables AI bullet rewrites
# ANTHROPIC_MODEL=claude-haiku-5-5    # optional override
# ALLOWED_ORIGINS=https://productrez.app

# GitHub Actions secrets for the daily jobs drop:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
